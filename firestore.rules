
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * NPB HRMS Security Protocol v1.0
     * Multi-Tenant Isolation & Hierarchical Access
     */
    
    function isSignedIn() {
      return request.auth != null;
    }

    // HRMS Specific Rules
    match /companies/{companyId} {
      allow read: if true; // Publicly readable for branding lookup
      allow write: if true; // Restrict to Super Admin in production
    }

    match /hrms_users/{userId} {
      allow read, write: if true; // Managed by Admin/HR/Support
    }

    match /attendance/{recordId} {
      allow read, write: if true; 
    }

    match /audit_logs/{logId} {
      allow create: if true;
      allow read: if true;
    }

    // Profiles & Carts: Restricted to the individual owner
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /carts/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Merchants Registry & Subcollections
    match /merchants/{merchantId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Default match for other collections
    match /{path=**} {
      allow read, write: if true; 
    }
  }
}
