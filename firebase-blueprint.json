{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "User profile with personal and contact information.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "mobile": { "type": "string" },
        "dob": { "type": "string" },
        "fullAddress": { "type": "string" },
        "photoURL": { "type": "string" },
        "resumeURL": { "type": "string" },
        "idCardURL": { "type": "string" },
        "idCardType": { "type": "string" },
        "provider": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "Cart": {
      "title": "Cart",
      "type": "object",
      "description": "User shopping cart containing software modules.",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Inquiry": {
      "title": "Inquiry",
      "type": "object",
      "description": "Contact message submitted by prospective clients.",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "pending", "solved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "email", "message"]
    },
    "Meeting": {
      "title": "Meeting",
      "type": "object",
      "description": "Virtual consultation scheduling record.",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "subject": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "progress", "discussion", "completed", "canceled"] },
        "meetingLink": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "email", "date", "timeSlot"]
    },
    "Job": {
      "title": "Job",
      "type": "object",
      "description": "Job opening in the career ecosystem.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "requirements": { "type": "string" },
        "salary": { "type": "string" },
        "location": { "type": "string" },
        "experience": { "type": "string" },
        "technologies": { "type": "string" },
        "education": { "type": "string" },
        "batchPassout": { "type": "string" },
        "lastDate": { "type": "string" },
        "category": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description"]
    },
    "JobApplication": {
      "title": "JobApplication",
      "type": "object",
      "description": "Candidate application submitted for a job opening.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "jobId": { "type": "string" },
        "jobTitle": { "type": "string" },
        "experience": { "type": "string" },
        "status": { "type": "string" },
        "applicantSnapshot": { "type": "object" },
        "hiringContext": { "type": "object" },
        "appliedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "jobId"]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "Software products and enterprise modules offered by NPB Media.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "marketValue": { "type": "number" },
        "features": { "type": "array" },
        "color": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "marketValue"]
    },
    "Merchant": {
      "title": "Merchant",
      "type": "object",
      "description": "Provisioned merchant account for retail POS & billing software.",
      "properties": {
        "shopName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "userId": { "type": "string" },
        "password": { "type": "string" },
        "plan": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["shopName", "userId", "password"]
    },
    "Company": {
      "title": "Company",
      "type": "object",
      "description": "Enterprise tenant within the HRMS ecosystem.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "portalName": { "type": "string" },
        "logoURL": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "disabled", "banned"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "portalName"]
    },
    "HrmsUser": {
      "title": "HrmsUser",
      "type": "object",
      "description": "Unified user entity for the HRMS platform.",
      "properties": {
        "uid": { "type": "string" },
        "companyId": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "support", "company_admin", "hr", "manager", "employee"] },
        "fullName": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "disabled", "banned", "deleted"] }
      },
      "required": ["uid", "role", "username", "password"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles and credentials."
    },
    "/carts/{userId}": {
      "schema": "Cart",
      "description": "User persistent shopping cart."
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "General customer inquiries and business proposals."
    },
    "/meetings/{meetingId}": {
      "schema": "Meeting",
      "description": "Scheduled virtual consultations."
    },
    "/careers/{jobId}": {
      "schema": "Job",
      "description": "Career opportunities registry."
    },
    "/jobApplications/{appId}": {
      "schema": "JobApplication",
      "description": "Candidate job applications."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Marketplace products catalog."
    },
    "/merchants/{merchantId}": {
      "schema": "Merchant",
      "description": "Merchant accounts for POS system."
    },
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Enterprise tenants."
    },
    "/hrms_users/{userId}": {
      "schema": "HrmsUser",
      "description": "HRMS multi-tenant user registry."
    }
  }
}
